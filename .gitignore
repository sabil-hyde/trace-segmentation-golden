.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
# regenerated with: python -m golden.view
data/**/view.html
# written by review/export; commit them deliberately when a reviewed version is frozen
data/**/review.jsonl
# rebuilt with: python -m golden.export [--unreviewed] (deterministic; seg.jsonl is ~170 MB)
data/**/export/
data/**/export-unreviewed/
.backup/
# per-item outputs, rebuilt by re-running a run; metrics.json + manifest.json are committed
runs/*/predictions.jsonl
runs/*/report.md
